{
  "name": "docer",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that keeps multi-repo architecture docs up to date",
  "license": "MIT",
  "scripts": {
    "build": "tsc && ncc build lib/main.js -o dist --source-map",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test 'lib/**/*.test.js'",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "ai": "^7.0.93",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.2"
  }
}
